# Production environment - kopieer naar infra/.env.prod en vul de echte waarden in.
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
APP_URL=
# DNS: laat de host uit APP_URL wijzen naar de productieserver.
APP_HOST_PORT=3002
POSTGRES_HOST_PORT=5434
POSTGRES_BIND_ADDRESS=127.0.0.1
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Alleen op true zetten als je bewust het bestaande owner-wachtwoord wilt overschrijven.
SEED_ADMIN_PASSWORD_FORCE=false
RABOBANK_CSV_PATHS=
RABOBANK_SAVINGS_IBANS=
TOTP_ENCRYPTION_KEY=
TOTP_PENDING_SECRET=
