# Production environment - kopieer naar infra/.env.prod en vul de echte waarden in.
POSTGRES_PASSWORD=<database-password>
DATABASE_URL=postgresql://huishouden:<database-password>@postgres:5432/huishouden
APP_URL=https://huishouden.latero.nl
# DNS: laat de host uit APP_URL wijzen naar de productieserver.
# Voor latero-prod is dat nu A=195.201.99.215 en optioneel AAAA=2a01:4f8:1c1b:e6b7::1.
APP_HOST_PORT=3002
POSTGRES_HOST_PORT=5434
POSTGRES_BIND_ADDRESS=127.0.0.1
SEED_ADMIN_EMAIL=leen@vdmeer.eu
SEED_ADMIN_PASSWORD=<production-password>
# Alleen op true zetten als je bewust het bestaande owner-wachtwoord wilt overschrijven.
SEED_ADMIN_PASSWORD_FORCE=false
RABOBANK_CSV_PATHS=
RABOBANK_SAVINGS_IBANS=NL93RABO1012731537
